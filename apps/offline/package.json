{
  "name": "osu-beatmap-request-module",
  "version": "1.5.6",
  "private": false,
  "scripts": {
    "start": "node ./bin/www",
    "build-pkg": "pkg ."
  },
  "dependencies": {
    "bancho.js": "^0.11.6",
    "express": "^4.21.0",
    "osu-api-extended": "^2.8.52"
  },
  "bin": "./bin/www",
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "scripts": [
      "app.js",
      "src/**/*.js"
    ],
    "assets": [
      "node_modules/lzma",
      "node_modules/lzma-native",
      "src/views/*.html"
    ],
    "outputPath": "dist",
    "compress": "GZip"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0"
  }
}
